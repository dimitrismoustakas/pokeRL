+    /// Last public protocol segment and each player's private request.
+    #[pyo3(signature = (i, opening, names=None))]
+    fn player_frame(
+        &self,
+        py: Python<'_>,
+        i: usize,
+        opening: bool,
+        names: Option<[String; 2]>,
+    ) -> PyResult<(u64, [Vec<String>; 2], [String; 2])> {
+        self.check_battle(i)?;
+        let space = Arc::new(self.env.space().clone());
+        py.detach(|| {
+            self.env.with_env(i, |e| {
+                let mut g = Game::from_battle(e.battle.clone(), space, e.sheets.clone());
+                if let Some(names) = names {
+                    g.players = names;
+                }
+                let logs = SideId::BOTH.map(|side| {
+                    let renderer = g.renderer(pikapro_protocol::Perspective::Player(side));
+                    let mut lines = if opening { renderer.header() } else { Vec::new() };
+                    lines.extend(renderer.log(&e.slot.recent_events));
+                    lines
+                });
+                let requests = SideId::BOTH.map(|side| {
+                    let changes = &mut g.changes[side.index()];
+                    changes.revealed = e.slot.own(side).revealed();
+                    changes.updated = changes.revealed != Default::default();
+                    for slot in 0..changes.cleared_disabled.len() {
+                        if changes.revealed.disabled[slot] != 0 {
+                            changes.cleared_disabled[slot] = true;
+                            changes.cleared_locked[slot] = true;
+                        }
+                    }
+                    g.request_json(side)
+                });
+                (e.slot.resolution, logs, requests)
+            })
+        })
+        .ok_or_else(|| PyIndexError::new_err("battle"))
+    }
