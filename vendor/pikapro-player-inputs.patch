+const MON_FEATURES: usize = 57;
+const BOTH_TEAM_FEATURES: usize = 12 * MON_FEATURES;
+
+/// Resolve the four public field positions from the same arrays exposed to the policy.
+fn v6_active_mechanics(
+    teams: &[i64],
+    continuous: &[f32],
+    events: &[i64],
+    flags: &[f32],
+    outcomes: &[f32],
+    meta: &[f32],
+    features: &mut [f32],
+    last_move: &mut [i64],
+) {
+    const WIDTH: usize = 17;
+    const RESOLUTION: usize = 6;
+    const FIRST_TURN: usize = 37;
+    const PROTECT_CHAIN: usize = 35;
+    const ACTIVE_TURNS: usize = 44;
+
+    for (pos, active) in features.chunks_exact_mut(WIDTH).enumerate() {
+        active[RESOLUTION] = 1.;
+        let side = pos / 2;
+        let slot = (pos % 2) as i64;
+        let team = &teams[side * 78..(side + 1) * 78];
+        if let Some(row) = team.chunks_exact(13).position(|mon| mon[10] == slot) {
+            let offset = (side * 6 + row) * MON_FEATURES;
+            active[0] = 1.;
+            for (dest, column) in active[1..4].iter_mut().zip([FIRST_TURN, PROTECT_CHAIN, ACTIVE_TURNS]) {
+                *dest = continuous[offset + column];
+            }
+        }
+    }
+    // Partial or overflowed history cannot determine the last resolution.
+    if meta[0] <= 0. || meta[1] > 0. || meta[2] > 0. {
+        return;
+    }
+    for (event_index, event) in events.chunks_exact(8).enumerate() {
+        let actor = event[1];
+        if !(1..=4).contains(&actor) {
+            continue;
+        }
+        let pos = actor as usize - 1;
+        let active = &mut features[pos * WIDTH..(pos + 1) * WIDTH];
+        let kind = event[0];
+        let resolution = match kind {
+            1 => 1,     // move
+            4 => 2,     // cant
+            2 | 3 => 3, // switch or drag
+            5 => 4,     // faint
+            6 => {
+                active[5] = 1.; // tera
+                continue;
+            }
+            _ => continue,
+        };
+        active[RESOLUTION..RESOLUTION + 5].fill(0.);
+        active[RESOLUTION + resolution] = 1.;
+        if kind == 1 {
+            last_move[pos] = event[3];
+            let event_flags = &flags[event_index * 5..(event_index + 1) * 5];
+            let targets = &outcomes[event_index * 32..(event_index + 1) * 32];
+            let any = |column: usize| targets.chunks_exact(8).any(|target| target[column] != 0.);
+            let failed = event_flags[0] != 0. || event_flags[3] != 0. || event_flags[4] != 0. || any(4);
+            let missed = event_flags[1] != 0. || any(1);
+            let immune = any(2);
+            let protected = any(5);
+            let blocked = any(3);
+            let hit = any(0) && !(failed || missed || immune || protected || blocked);
+            for (dest, flag) in active[11..].iter_mut().zip([failed, missed, immune, protected, blocked, hit]) {
+                *dest = f32::from(u8::from(flag));
+            }
+        } else if matches!(kind, 2 | 3 | 5) {
+            last_move[pos] = 0;
+            active[4] = f32::from(u8::from(kind != 5));
+            active[5] = 0.;
+            active[11..].fill(0.);
+        }
+    }
+}
