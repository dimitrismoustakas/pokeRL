+/// The v6 checkpoint indexes switches by its own (living actives first) roster.
+/// Slots which have fainted remain valid explicit targets for Showdown retargeting.
+fn v6_request_menu(
+    view: &PlayerView<'_>,
+    shown: impl FnOnce() -> LegalActions,
+    own_rows: &[i64],
+    moves: &[i64],
+    recharge: i64,
+    base_meta: &[[i64; 2]],
+    types: &[i64],
+    joint: &mut [bool],
+    tera: &mut [bool],
+    ids: &mut [i64],
+    meta: &mut [i64],
+) {
+    use pikapro_data::{
+        MoveId, MoveTarget as T, Type,
+        gen9::{moves as mv, species as sp},
+    };
+    use pikapro_view::{OwnMoves, OwnRequest, PublicVolatiles};
+    const PASS: usize = 26;
+    let own = view.own;
+    if view.public.outcome.is_some() {
+        joint[PASS] = true;
+        joint[(1 + PASS) * 27 + PASS] = true;
+        return;
+    }
+    match own.request {
+        OwnRequest::Move => {}
+        OwnRequest::ForceSwitch { .. } => {
+            // A prior switch can still be queued when an Eject Pack interrupts it.
+            // Translate the same player-visible choices VecEnv offers for this request.
+            let menu = shown();
+            if menu.is_waiting() {
+                joint[PASS] = true;
+                joint[(1 + PASS) * 27 + PASS] = true;
+                return;
+            }
+            let index = |choice| match choice {
+                SlotAction::Pass => PASS,
+                SlotAction::Switch(position) => {
+                    20 + own_rows
+                        .chunks_exact(13)
+                        .position(|row| row[12] == i64::from(position))
+                        .expect("switch must refer to an own team position")
+                }
+                _ => unreachable!("a replacement request offers only switch or pass"),
+            };
+            for choice in menu.joint() {
+                let Choice::Actions([first, second]) = choice else { unreachable!() };
+                let (a, b) = (index(first), index(second));
+                joint[a] = true;
+                joint[(1 + a) * 27 + b] = true;
+            }
+            return;
+        }
+        _ => {
+            joint[PASS] = true;
+            joint[(1 + PASS) * 27 + PASS] = true;
+            return;
+        }
+    }
+    let live = |m: &&pikapro_view::OwnMon| m.active && m.hp > 0;
+    let ordered = own.mons.iter().filter(live).chain(own.mons.iter().filter(|m| !live(m)));
+    let switches: Vec<_> = ordered.enumerate().filter_map(|(i, m)| (!m.active && m.hp > 0).then_some(20 + i)).collect();
+    let mut masks = [[false; 27]; 2];
+    for slot in 0..2 {
+        let enabled = &mut masks[slot];
+        let active = own.active[slot].as_ref();
+        let mon = own.mons.get(slot);
+        let living = mon.is_some_and(|m| m.active && m.hp > 0);
+        if !(living && (own.known_trapped[slot] || active.is_some_and(|a| a.trapped))) {
+            for &s in &switches {
+                enabled[s] = true;
+            }
+        }
+        if let (Some(a), Some(mon)) = (active, mon.filter(|_| living)) {
+            tera[slot] = a.can_terastallize.is_some();
+            let mut add = |j: usize, id: Option<MoveId>, target: T| {
+                let id_index = id.map_or(recharge, |m| moves[1 + m.index()]);
+                let mut info = base_meta[id_index as usize];
+                if id == Some(mv::IVY_CUDGEL) {
+                    let ty = match mon.species {
+                        sp::OGERPON_WELLSPRING | sp::OGERPON_WELLSPRING_TERA => Type::Water,
+                        sp::OGERPON_CORNERSTONE | sp::OGERPON_CORNERSTONE_TERA => Type::Rock,
+                        sp::OGERPON_HEARTHFLAME | sp::OGERPON_HEARTHFLAME_TERA => Type::Fire,
+                        _ => Type::Grass,
+                    };
+                    info[0] = types[ty as usize];
+                } else if id == Some(mv::TERA_BLAST) {
+                    if let Some(ty) = mon.terastallized {
+                        info[0] = types[ty as usize];
+                        let boosts = &view.my_side().slots[slot].boosts;
+                        let stat = |i: usize| {
+                            let stage = i32::from(boosts[i]);
+                            i32::from(mon.stats[i]) * (2 + stage.max(0)) / (2 - stage.min(0))
+                        };
+                        if stat(0) > stat(2) {
+                            info[1] = 1;
+                        }
+                    }
+                }
+                ids[slot * 4 + j] = id_index;
+                meta[(slot * 4 + j) * 2..(slot * 4 + j + 1) * 2].copy_from_slice(&info);
+                let target = if id == Some(mv::POLLEN_PUFF)
+                    && view.my_side().slots[slot].volatiles.has(PublicVolatiles::HEAL_BLOCK)
+                {
+                    T::AdjacentFoe
+                } else if id == Some(mv::TERA_STARSTORM) && mon.terastallized == Some(Type::Stellar) {
+                    T::AllAdjacentFoes
+                } else {
+                    target
+                };
+                let offsets: &[usize] = match target {
+                    T::Normal | T::Any => &[0, 1, 2],
+                    T::AdjacentFoe => &[0, 1],
+                    T::AdjacentAlly => &[2],
+                    T::AdjacentAllyOrSelf => &[2, 3],
+                    _ => &[4],
+                };
+                for &offset in offsets {
+                    let recorded = match offset {
+                        0 | 1 => view.foe_side().slots[offset].row.is_some(),
+                        2 => view.my_side().slots[1 - slot].row.is_some(),
+                        3 => view.my_side().slots[slot].row.is_some(),
+                        _ => true,
+                    };
+                    enabled[5 * j + offset] = recorded;
+                }
+            };
+            if mon.commanding {
+                if !enabled.iter().any(|&b| b) {
+                    enabled[PASS] = true;
+                }
+                continue;
+            }
+            match &a.moves {
+                OwnMoves::Struggle => add(0, Some(mv::STRUGGLE), T::RandomNormal),
+                OwnMoves::Recharge => add(0, None, T::User),
+                OwnMoves::Locked(m) => add(0, Some(*m), T::User),
+                OwnMoves::Moves(ms) => {
+                    for (j, m) in ms.iter().enumerate() {
+                        if !m.disabled && own.known_disabled[slot] & (1 << j) == 0 {
+                            add(j, Some(m.id), m.target);
+                        }
+                    }
+                }
+            }
+        }
+        if !enabled.iter().any(|&b| b) {
+            enabled[PASS] = true;
+        }
+    }
+    for (a, &yes) in masks[0].iter().enumerate() {
+        if !yes {
+            continue;
+        }
+        for (b, &yes2) in masks[1].iter().enumerate() {
+            if yes2 && !(a == b && (20..26).contains(&a)) {
+                joint[a] = true;
+                joint[(1 + a) * 27 + b] = true;
+            }
+        }
+    }
+}
