+#[derive(Clone, Debug, Default)]
+pub struct PublicActions {
+    pub current: Vec<PublicAction>,
+    pub previous: Vec<PublicAction>,
+    pub current_overflow: u16,
+    pub previous_overflow: u16,
+    last_move_line: Option<usize>,
+    active_move: Option<usize>,
+    pub turn: u16,
+    pub weather_start: u16,
+    pub terrain_start: u16,
+    pub trick_start: u16,
+    pub side_starts: [[Option<u16>; 4]; 2],
+}
+
+impl PublicActions {
+    fn apply(&mut self, tracker: &mut PublicTracker, event: &pikapro::BattleEvent) {
+        use pikapro::BattleEvent::Damage;
+        use pikapro::event::DamageSource;
+        // Read both bars through the public tracker. Recoil, status, and
+        // item damage have their own sources; direct HP paid by the user
+        // (Substitute, Belly Drum) names the user as its target.
+        if let Damage { target, source: DamageSource::Move, .. } = event
+            && let Some(i) = self.active_move
+            && field_position(target) != 0
+            && field_position(target) != self.current[i].core[1]
+        {
+            let slot = usize::from(target.pos.slot);
+            let before = tracker.side(target.pos.side).slots[slot].hp;
+            tracker.apply(event);
+            let after = tracker.side(target.pos.side).slots[slot].hp;
+            if before.is_known() && after.is_known() {
+                let fraction = |bar: pikapro_view::HpView| f32::from(bar.hp) / f32::from(bar.max);
+                let result = &mut self.current[i].outcomes[usize::from(field_position(target) - 1)];
+                *result.damage.get_or_insert(0.) += (fraction(before) - fraction(after)).max(0.);
+            }
+        } else {
+            tracker.apply(event);
+        }
+        self.observe(event);
+    }
+
+    fn observe(&mut self, event: &pikapro::BattleEvent) {
+        use pikapro::BattleEvent::*;
+        use pikapro::event::{CantReason, FieldEffect, MoveAttr as Attribute, MoveFrom};
