+        self.v6_moves = vec![0; dex.moves.len() + 1];
+        for (name, index) in vocab {
+            if let Some(id) = dex.move_by_name(&name) {
+                self.v6_moves[1 + id.index()] = index;
+            }
+        }
+    }
