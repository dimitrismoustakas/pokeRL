+    /// Own request stats, public HP of opposing actives, and bounded public actions.
+    /// Batched direct arrays in checkpoint index space. No battle state or renderer.
+    #[pyo3(signature = (lanes=None))]
+    fn v6_player_inputs<'py>(&self, py: Python<'py>, lanes: Option<Vec<usize>>) -> PyResult<Bound<'py, PyDict>> {
+        if self.v6_moves.is_empty() {
+            return Err(err("set the checkpoint move vocabulary first".into()));
+        }
+        let selected = lanes.unwrap_or_else(|| (0..self.n()).collect());
+        for &lane in &selected {
+            self.check_battle(lane)?;
+        }
+        let n = selected.len();
+        let (
+            events,
+            flags,
+            outcomes,
+            activations,
+            damage,
+            meta,
+            joint,
+            tera,
+            requests,
+            request_meta,
+            field,
+            teams,
+            continuous,
+            last_moves,
+            mechanics,
+            mechanics_move,
+        ) = py.detach(|| {
+            let mut events = vec![0i64; n * 2 * 12 * 8];
+            let mut flags = vec![0f32; n * 2 * 12 * 5];
+            let mut outcomes = vec![0f32; n * 2 * 12 * 4 * 8];
+            let mut activations = vec![0i64; n * 2 * 12 * 4];
+            let mut damage = vec![-1f32; n * 2 * 12 * 4];
+            let mut meta = vec![0f32; n * 2 * 3];
+            let tables = pikapro_rl::tables::Tables::for_format(&self.env.config().format);
+            let mut mechanics = vec![0f32; n * 2 * 4 * 17];
+            let mut mechanics_move = vec![0i64; n * 2 * 4];
+            let mut teams = vec![0i64; n * 2 * 2 * 6 * 13];
+            let mut last_moves = vec![0i64; n * 2 * 2 * 6];
+            let mut continuous = vec![0f32; n * 2 * BOTH_TEAM_FEATURES];
+            let mut field = vec![0f32; n * 2 * 36];
+            let mut joint = vec![false; n * 2 * 28 * 27];
+            let mut tera = vec![false; n * 2 * 2];
+            let mut requests = vec![0i64; n * 2 * 8];
+            let mut request_meta = vec![0i64; n * 2 * 16];
+            for (row, &lane) in selected.iter().enumerate() {
+                self.env
+                    .with_env(lane, |e| {
+                        for side in SideId::BOTH {
+                            let seat = row * 2 + side.index();
+                            let v = e.slot.view(side);
+                            v6_team_categories(
+                                &v,
+                                &tables,
+                                self,
+                                &e.slot.last_own_roster[side.index()],
+                                &e.slot.shown_species[side.foe().index()],
+                                &mut teams[seat * 156..(seat + 1) * 156],
+                                &mut continuous[seat * BOTH_TEAM_FEATURES..(seat + 1) * BOTH_TEAM_FEATURES],
+                                &mut last_moves[seat * 12..(seat + 1) * 12],
+                            );
+                            v6_request_menu(
+                                &v,
+                                || pikapro_rl::env::shown(&e.battle, e.slot.own(side), e.slot.tracker_of(side), side),
+                                &teams[seat * 156..seat * 156 + 78],
+                                &self.v6_moves,
+                                self.v6_recharge,
+                                &self.v6_meta,
+                                &self.v6_types,
+                                &mut joint[seat * 756..(seat + 1) * 756],
+                                &mut tera[seat * 2..(seat + 1) * 2],
+                                &mut requests[seat * 8..(seat + 1) * 8],
+                                &mut request_meta[seat * 16..(seat + 1) * 16],
+                            );
+                            let history = &e.slot.public_actions;
+                            let f = &mut field[seat * 36..(seat + 1) * 36];
+                            use pikapro::state::{SideCondition as C, Terrain as T, Weather as W};
+                            let public = v.field();
+                            let age = |start, cap: u16, base: u16| {
+                                f32::from((history.turn.saturating_sub(start) + base).min(cap)) / f32::from(cap)
+                            };
+                            let weather = match public.weather {
+                                None => 0,
+                                Some(W::Sun) => 1,
+                                Some(W::HarshSun) => 2,
+                                Some(W::Rain) => 3,
+                                Some(W::HeavyRain) => 4,
+                                Some(W::Sand) => 5,
+                                Some(W::Snow) => 7,
+                                Some(W::StrongWinds) => 8,
+                            };
+                            f[weather] = 1.;
+                            if weather != 0 {
+                                f[9] = age(history.weather_start, 8, 0);
+                            }
+                            let terrain = match public.terrain {
+                                None => 0,
+                                Some(T::Electric) => 1,
+                                Some(T::Grassy) => 2,
+                                Some(T::Misty) => 3,
+                                Some(T::Psychic) => 4,
+                            };
+                            f[10 + terrain] = 1.;
+                            if terrain != 0 {
+                                f[15] = age(history.terrain_start, 8, 0);
+                            }
+                            for (relative, (which, observed)) in
+                                [(side, v.my_side()), (side.foe(), v.foe_side())].into_iter().enumerate()
+                            {
+                                let j = 16 + relative * 8;
+                                for (k, (c, cap)) in
+                                    [(C::StealthRock, 1.), (C::Spikes, 3.), (C::ToxicSpikes, 2.), (C::StickyWeb, 1.)]
+                                        .into_iter()
+                                        .enumerate()
+                                {
+                                    f[j + k] = f32::from(observed.condition(c).layers) / cap;
+                                }
+                                for (k, start) in history.side_starts[which.index()].iter().enumerate() {
+                                    if let Some(t) = start {
+                                        f[j + 4 + k] = age(*t, if k == 3 { 4 } else { 8 }, 1);
+                                    }
+                                }
+                            }
+                            if public.trick_room.is_some() {
+                                f[32] = age(history.trick_start, 5, 1);
+                            }
+                            f[33] = u8::from(v.my_side().tera_used) as f32;
+                            f[34] = u8::from(v.foe_side().tera_used) as f32;
+                            f[35] = age(0, 20, 0);
+                            let partial = !history.current.is_empty();
+                            let (rows, overflow) = if partial {
+                                (&history.current, history.current_overflow)
+                            } else {
+                                (&history.previous, history.previous_overflow)
+                            };
+                            let rel = |x: u16| {
+                                if x == 0 || side.index() == 0 { i64::from(x) } else { i64::from((x - 1 + 2) % 4 + 1) }
+                            };
+                            if !rows.is_empty() {
+                                meta[seat * 3] = 1.;
+                                meta[seat * 3 + 1] = u8::from(partial && v.public.outcome.is_none()) as f32;
+                                meta[seat * 3 + 2] = f32::from(overflow.min(12)) / 12.;
+                            }
+                            for (j, action) in rows.iter().enumerate() {
+                                let [kind, actor, target, mv] = action.core;
+                                let row = seat * 12 + j;
+                                let id = self.v6_moves[usize::from(mv)];
+                                events[row * 8..row * 8 + 8].copy_from_slice(&[
+                                    i64::from(kind),
+                                    rel(actor),
+                                    rel(target),
+                                    id,
+                                    action.source_move.map_or(0, |m| self.v6_moves[1 + m.index()]),
+                                    if mv == 0 { 0 } else { self.v6_scopes[id as usize] },
+                                    action.species.map_or(0, |s| self.v6_species[s.index()]),
+                                    action.tera.map_or(0, |t| self.v6_types[t as usize]),
+                                ]);
+                                for bit in 0..5 {
+                                    flags[row * 5 + bit] = f32::from((action.flags >> bit) & 1);
+                                }
+                                for (absolute, t) in action.outcomes.iter().enumerate() {
+                                    let p = row * 4 + rel(absolute as u16 + 1) as usize - 1;
+                                    let declared = if action.spread != 0 {
+                                        action.spread & (1 << absolute) != 0
+                                    } else {
+                                        target as usize == absolute + 1
+                                    };
+                                    let mut bits = t.flags;
+                                    if declared {
+                                        bits |= 1 | 1 << 7;
+                                        if action.miss_on_line {
+                                            bits |= 1 << 1;
+                                        }
+                                    }
+                                    for bit in 0..8 {
+                                        outcomes[p * 8 + bit] = f32::from((bits >> bit) & 1);
+                                    }
+                                    outcomes[p * 8 + 6] = f32::from(t.hit_count) / 10.;
+                                    activations[p] = t.activation.map_or(0, |m| self.v6_moves[1 + m.index()]);
+                                    if let Some(loss) = t.damage {
+                                        damage[p] = loss;
+                                    }
+                                }
+                            }
+                            v6_active_mechanics(
+                                &teams[seat * 156..(seat + 1) * 156],
+                                &continuous[seat * BOTH_TEAM_FEATURES..(seat + 1) * BOTH_TEAM_FEATURES],
+                                &events[seat * 96..(seat + 1) * 96],
+                                &flags[seat * 60..(seat + 1) * 60],
+                                &outcomes[seat * 384..(seat + 1) * 384],
+                                &meta[seat * 3..(seat + 1) * 3],
+                                &mut mechanics[seat * 68..(seat + 1) * 68],
+                                &mut mechanics_move[seat * 4..(seat + 1) * 4],
+                            );
+                        }
+                    })
+                    .expect("index is within n");
+            }
+            (
+                events,
+                flags,
+                outcomes,
+                activations,
+                damage,
+                meta,
+                joint,
+                tera,
+                requests,
+                request_meta,
+                field,
+                teams,
+                continuous,
+                last_moves,
+                mechanics,
+                mechanics_move,
+            )
+        });
+        let out = PyDict::new(py);
+        out.set_item("move_damage", array(py, damage, vec![n, 2, 12, 4])?)?;
+        out.set_item("own_request_moves", array(py, requests, vec![n, 2, 2, 4])?)?;
+        out.set_item("own_request_move_metadata", array(py, request_meta, vec![n, 2, 2, 4, 2])?)?;
+        out.set_item("teams", array(py, teams, vec![n, 2, 2, 6, 13])?)?;
+        out.set_item("last_moves", array(py, last_moves, vec![n, 2, 2, 6])?)?;
+        out.set_item("continuous", array(py, continuous, vec![n, 2, 2, 6, MON_FEATURES])?)?;
+        out.set_item("field", array(py, field, vec![n, 2, 36])?)?;
+        out.set_item("joint", array(py, joint, vec![n, 2, 28, 27])?)?;
+        out.set_item("can_tera", array(py, tera, vec![n, 2, 2])?)?;
+        out.set_item("active_mechanics", array(py, mechanics, vec![n, 2, 4, 17])?)?;
+        out.set_item("active_mechanics_move", array(py, mechanics_move, vec![n, 2, 4])?)?;
+        out.set_item("events", array(py, events, vec![n, 2, 12, 8])?)?;
+        out.set_item("recent_event_flags", array(py, flags, vec![n, 2, 12, 5])?)?;
+        out.set_item("recent_event_target_outcomes", array(py, outcomes, vec![n, 2, 12, 4, 8])?)?;
+        out.set_item("recent_event_target_activation_move", array(py, activations, vec![n, 2, 12, 4])?)?;
+        out.set_item("meta", array(py, meta, vec![n, 2, 3])?)?;
+        Ok(out)
+    }
