+/// Encode each team as seen from this player's information set.
+fn v6_team_categories(
+    view: &PlayerView<'_>,
+    tables: &pikapro_rl::tables::Tables,
+    vocab: &PyVecEnv,
+    own_order: &[(u8, pikapro_data::SpeciesId)],
+    shown: &[Option<pikapro_data::SpeciesId>; 6],
+    rows: &mut [i64],
+    continuous: &mut [f32],
+    last_moves: &mut [i64],
+) {
+    use pikapro_rl::encode::ViewCtx;
+    use pikapro_view::{AbilityState, ItemState, Phase};
+    let state = ViewCtx::new(view, tables);
+    let started = !matches!(view.public.phase, Phase::Setup | Phase::TeamPreview);
+    for who in 0..2 {
+        let count = if who == 0 { own_order.len() } else { view.foe_side().mons.len() };
+        let index = |i: usize| if who == 0 { usize::from(own_order[i].0) } else { i };
+        let active = |i: usize| {
+            let m = state.mon(who, index(i));
+            started && m.slot.is_some() && !m.is_fainted()
+        };
+        let order = (0..count).filter(|&i| active(i)).chain((0..count).filter(|&i| !active(i)));
+        for i in 0..6 {
+            let k = (who * 6 + i) * 13;
+            rows[k + 10] = 2;
+            rows[k + 11] = 1;
+            rows[k + 12] = -1;
+        }
+        for (i, original) in order.enumerate() {
+            let m = state.mon(who, index(original));
+            let start = (who * 6 + i) * 13;
+            let r = &mut rows[start..start + 13];
+            let identity = match who {
+                0 if view.public.outcome.is_some() => Some(own_order[original].1),
+                0 => m.species(),
+                _ => shown[index(original)].or(m.species()),
+            };
+            if let Some(s) = identity {
+                r[0] = vocab.v6_species[s.index()];
+            }
+            if let AbilityState::Known(a) = m.ability() {
+                r[1] = vocab.v6_abilities[a.index()];
+            }
+            let item = m.item();
+            if let ItemState::Known(id) | ItemState::Gone { item: Some(id), .. } = item {
+                r[2] = vocab.v6_items[id.index()];
+            }
+            if let Some(current) = m.species() {
+                let types = m.active.and_then(|a| a.types).unwrap_or(tables.dex.species(current).types);
+                r[3] = vocab.v6_types[types.primary as usize];
+                if let Some(t) = types.secondary {
+                    r[4] = vocab.v6_types[t as usize];
+                }
+            }
+            let tera = if who == 0 { m.own_mon.map(|o| o.tera_type) } else { m.public.and_then(|p| p.tera_type) };
+            if let Some(t) = tera {
+                r[5] = vocab.v6_types[t as usize];
+            }
+            if who == 1 {
+                if let Some(public) = m.public {
+                    for (j, mv) in public.moves.iter().filter(|mv| mv.uses > 0).take(4).enumerate() {
+                        r[6 + j] = vocab.v6_moves[1 + mv.id.index()];
+                    }
+                }
+            } else {
+                for (j, mv) in m.moves().iter().enumerate() {
+                    if let Some(id) = mv.slot.id() {
+                        r[6 + j] = vocab.v6_moves[1 + id.index()];
+                    }
+                }
+            }
+            if let Some(slot) = m.slot.filter(|_| active(original)) {
+                r[10] = i64::from(slot);
+            }
+            r[11] = 0;
+            r[12] = if who == 0 { m.team_pos.map_or(-1, i64::from) } else { index(original) as i64 };
+            if let Some(last) = m.active.and_then(|a| a.last_move) {
+                last_moves[who * 6 + i] = vocab.v6_moves[1 + last.index()];
+            }
+            let offset = (who * 6 + i) * MON_FEATURES;
+            let out = &mut continuous[offset..offset + MON_FEATURES];
+            let truth = |b: bool| f32::from(u8::from(b));
+            let (v, max) = m.hp();
+            if max > 0 && (who == 0 || m.public.is_some_and(|p| p.hp.is_known())) {
+                out[0] = f32::from(v) / f32::from(max);
+            }
+            use pikapro_view::{PublicVolatiles as V, StatusKind};
+            if !m.is_fainted() {
+                let status = match m.status() {
+                    StatusKind::None => 0,
+                    StatusKind::Burn => 1,
+                    StatusKind::Freeze => 2,
+                    StatusKind::Paralysis => 3,
+                    StatusKind::Poison => 4,
+                    StatusKind::Sleep => 5,
+                    StatusKind::Toxic => 6,
+                };
+                out[1 + status] = 1.;
+            }
+            for (j, boost) in m.boosts().iter().enumerate() {
+                out[8 + j] = f32::from(*boost) / 6.;
+            }
+            if let Some(active) = m.active {
+                if let Some(stat) = active.boosted_stat
+                    && !m.is_fainted()
+                {
+                    out[51 + stat as usize] = 1.;
+                }
+                // Nightmare is unavailable in Generation 9 Regulation F.
+                let effects = [
+                    V::CONFUSION,
+                    V::SUBSTITUTE,
+                    V::LEECH_SEED,
+                    V::TAUNT,
+                    V::ENCORE,
+                    V::TORMENT,
+                    V::DISABLE,
+                    V::YAWN,
+                    V::PERISH_SONG,
+                    V::PROTECT,
+                    V::ENDURE,
+                    V::FOCUS_ENERGY,
+                    V::ATTRACT,
+                    V::CURSE,
+                    0,
+                    V::FLASH_FIRE,
+                ];
+                for (j, flag) in effects.iter().enumerate() {
+                    if *flag != 0 && active.volatiles.has(*flag) {
+                        out[15 + j] =
+                            if *flag == V::PERISH_SONG { f32::from(active.counters.perish + 1) / 4. } else { 1. };
+                    }
+                }
+                out[35] = f32::from(active.counters.protect_chain.min(4)) / 4.;
+                out[37] = truth(active.turns_active == 1);
+                out[44] = f32::from(active.turns_active.min(6)) / 6.;
+            }
+            if matches!(m.status(), StatusKind::Toxic | StatusKind::Sleep) {
+                out[36] = f32::from(m.status_turns().min(8)) / 8.;
+            }
+            if who == 0 {
+                for (j, mv) in m.moves().iter().enumerate() {
+                    let requested = m
+                        .request
+                        .and_then(|req| match &req.moves {
+                            pikapro_view::OwnMoves::Moves(moves) => moves.get(j),
+                            _ => None,
+                        })
+                        .is_some_and(|slot| Some(slot.id) == mv.slot.id());
+                    // A pivot or forced switch can spend PP after the last
+                    // private move menu. Use the public PP tally between menus.
+                    out[31 + j] = match (requested, mv.max_pp) {
+                        (false, Some(max)) if mv.revealed && max > 0 => {
+                            f32::from(max.saturating_sub(mv.pp_spent)) / f32::from(max)
+                        }
+                        _ => mv.pp_frac(tables),
+                    };
+                }
+                if let Some(stats) = m.exact_stats() {
+                    for (j, x) in stats.into_iter().enumerate() {
+                        out[45 + j] = f32::from(x) / 256.;
+                    }
+                }
+            }
+            out[38] = truth(m.is_revealed());
+            out[39] = r[6..10].iter().filter(|&&id| id != 0).count() as f32 / 4.;
+            out[40] = truth(matches!(m.ability(), AbilityState::Known(_)));
+            out[41] = truth(matches!(
+                item, ItemState::Known(_) | ItemState::NoItem | ItemState::Gone { item: Some(_), .. }
+            ));
+            out[42] = truth(tera.is_some());
+            out[43] =
+                truth(m.terastallized() || m.public.is_some_and(|p| p.flags.has(pikapro_view::MonFlags::USED_TERA)));
+            out[56] = truth(matches!(item, ItemState::Gone { .. }));
+        }
+    }
+}
