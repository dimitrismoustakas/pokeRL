+/// Public outcomes for the four field positions, observed after a move.
+#[derive(Clone, Copy, Debug, Default)]
+pub struct TargetResult {
+    pub flags: u8,
+    pub hit_count: u8,
+    pub activation: Option<pikapro_data::MoveId>,
+    /// Fraction of visible HP lost to this move's direct hits, including rounded zero.
+    pub damage: Option<f32>,
+}
+
+#[derive(Clone, Copy, Debug, Default)]
+pub struct PublicAction {
+    pub core: [u16; 4],
+    pub source_move: Option<pikapro_data::MoveId>,
+    pub species: Option<pikapro_data::SpeciesId>,
+    pub tera: Option<pikapro_data::Type>,
+    pub flags: u8,
+    pub spread: u8,
+    pub miss_on_line: bool,
+    pub outcomes: [TargetResult; 4],
+}
+
+fn field_position(a: &pikapro::event::Actor) -> u16 {
+    if a.active && a.pos.slot < 2 { 1 + a.pos.side.index() as u16 * 2 + u16::from(a.pos.slot) } else { 0 }
+}
+
+impl PublicAction {
+    fn outcome(&mut self, actor: &pikapro::event::Actor, flag: u8) -> Option<&mut TargetResult> {
+        let p = field_position(actor);
+        if p == 0 {
+            return None;
+        }
+        let t = &mut self.outcomes[usize::from(p - 1)];
+        t.flags |= 1 | flag;
+        Some(t)
+    }
+
+    fn activation(&mut self, actor: &pikapro::event::Actor, id: pikapro_data::MoveId) {
+        use pikapro_data::gen9::moves as m;
+        if let Some(t) = self.outcome(actor, 0) {
+            t.activation.get_or_insert(id);
+            if matches!(
+                id,
+                m::BANEFUL_BUNKER
+                    | m::BURNING_BULWARK
+                    | m::CRAFTY_SHIELD
+                    | m::DETECT
+                    | m::KINGS_SHIELD
+                    | m::MAT_BLOCK
+                    | m::OBSTRUCT
+                    | m::PROTECT
+                    | m::QUICK_GUARD
+                    | m::SILK_TRAP
+                    | m::SPIKY_SHIELD
+                    | m::WIDE_GUARD
+            ) {
+                t.flags |= 1 << 5;
+            }
+        }
+    }
+
+    fn failed(&mut self, actor: &pikapro::event::Actor) {
+        self.flags |= 1;
+        if field_position(actor) == self.core[1] {
+            self.flags |= 1 << 3;
+        }
+        self.outcome(actor, 1 << 4);
+    }
+
+    fn minor(&mut self, event: &pikapro::BattleEvent) {
+        use pikapro::BattleEvent::*;
+        use pikapro::event::{EffectName, VolatileEffect as V};
+        use pikapro::state::Terrain;
+        use pikapro_data::gen9::moves as m;
+        match event {
+            Miss { user, target } if field_position(user) == self.core[1] => {
+                self.flags |= 1 << 1;
+                self.outcome(target, 1 << 1);
+            }
+            Immune { target } | OhkoImmune { target } | ImmuneFrom { target, .. } => {
+                self.outcome(target, 1 << 2);
+            }
+            Block { actor, .. } => {
+                self.outcome(actor, 1 << 3);
+            }
+            Fail { user } | NoTarget { user } | MoveFail { user, .. } | WeatherMoveFail { user, .. } => {
+                self.failed(user)
+            }
+            HealFail { target }
+            | StatusFail { target, .. }
+            | UproarPreventsSleep { target, .. }
+            | FailFrom { target, .. }
+            | FailBy { target, .. } => self.failed(target),
+            WeatherFail { source, effect: EffectName::Move(_) | EffectName::Item(_), .. } => self.failed(source),
+            HitCount { target, hits } => {
+                if let Some(t) = self.outcome(target, 0) {
+                    t.hit_count = (*hits).min(10);
+                }
+            }
+            Protected { target } => self.activation(target, m::PROTECT),
+            ProtectionBroken { target, move_id } | ActivateMove { target, move_id, .. } => {
+                self.activation(target, *move_id)
+            }
+            MoveActivate { actor, move_id, .. }
+            | ActivateEffect { actor, effect: EffectName::Move(move_id), .. }
+            | EffectStart { actor, effect: V::PartiallyTrapped(move_id), .. } => self.activation(actor, *move_id),
+            StruggleStart { actor } => self.activation(actor, m::STRUGGLE),
+            PpDrain { target, .. } => self.activation(target, m::EERIE_SPELL),
+            TerrainActivate { target, terrain } => self.activation(
+                target,
+                match terrain {
+                    Terrain::Electric => m::ELECTRIC_TERRAIN,
+                    Terrain::Grassy => m::GRASSY_TERRAIN,
+                    Terrain::Misty => m::MISTY_TERRAIN,
+                    Terrain::Psychic => m::PSYCHIC_TERRAIN,
+                },
+            ),
+            EffectActivate { actor, effect, .. } => {
+                let mv = match effect {
+                    V::Substitute => m::SUBSTITUTE,
+                    V::PartiallyTrapped(m) => *m,
+                    V::LeechSeed => m::LEECH_SEED,
+                    V::Curse => m::CURSE,
+                    V::PerishSong => m::PERISH_SONG,
+                    V::DestinyBond => m::DESTINY_BOND,
+                    V::Attract => m::ATTRACT,
+                    V::Torment => m::TORMENT,
+                    V::SaltCure => m::SALT_CURE,
+                    V::SyrupBomb => m::SYRUP_BOMB,
+                    V::ThroatChop => m::THROAT_CHOP,
+                    V::GlaiveRush => m::GLAIVE_RUSH,
+                    V::Endure => m::ENDURE,
+                    V::SmackDown => m::SMACK_DOWN,
+                    V::MagnetRise => m::MAGNET_RISE,
+                    V::FairyLock => m::FAIRY_LOCK,
+                    V::Octolock => m::OCTOLOCK,
+                    V::NoRetreat => m::NO_RETREAT,
+                    V::Yawn => m::YAWN,
+                    V::HealBlock => m::HEAL_BLOCK,
+                    V::Imprison => m::IMPRISON,
+                    V::Trapped => {
+                        self.outcome(actor, 0);
+                        return;
+                    }
+                };
+                self.activation(actor, mv);
+            }
+            _ => {}
+        }
+    }
+}
