+                )
+                amended = self._public_events_current[move_index]
+                self._public_events_current[move_index] = replace(
+                    amended, failed=True, action_failed=True
+                )
+            else:
+                self._replace_public_move_target(
+                    move_index, target, failed=True, failed_action=failed_action or None
+                )
+                amended = self._public_events_current[move_index]
+                self._public_events_current[move_index] = replace(amended, failed=True)
+        elif event_type == "-hitcount":
