+    def _register_request_generation(self, request: Dict[str, Any]) -> None:
+        """Track one simulator decision generation across transport backends.
+
+        The simulator emits one request per side for each decision generation,
+        using ``wait`` for a side that cannot act. Direct BattleStream requests
+        omit ``rqid`` while websocket rqids differ between sides, so neither is
+        a cross-player identity. Counting every non-update request locally
+        yields the same battle-local generation on both views. Updated requests
+        and duplicate websocket deliveries retain the current generation.
+        """
+        rqid = request.get("rqid")
+        duplicate_rqid = rqid is not None and rqid == self._last_request_rqid
+        if not request.get("update", False) and not duplicate_rqid:
+            self._request_generation += 1
+        if rqid is not None:
+            self._last_request_rqid = rqid
