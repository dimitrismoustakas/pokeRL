+        """Attach public minor-action facts to their preceding move event.
+
+        Showdown emits one major ``move`` line followed by contiguous minor
+        lines describing its interactions.  Updating the bounded move record
+        avoids exposing an unbounded stream of damage/animation messages while
+        retaining the mechanics that decision-time consumers need.
+        """
+
+        if len(event) < 2:
+            return False
+        event_type = event[1]
+        if event_type not in {
+            "-activate",
+            "-block",
+            "-fail",
+            "-hitcount",
+            "-immune",
+            "-miss",
+            "-notarget",
+        }:
+            return False
+
+        if event_type == "-activate":
+            activation = str(event[3]) if len(event) > 3 else ""
+            if not activation.lower().startswith("move:"):
+                return False
+        actor = None
+        if event_type == "-miss" and len(event) > 2:
+            actor = str(event[2])
+        elif event_type == "-block" and len(event) > 5:
+            candidate = str(event[5])
+            if candidate and not candidate.startswith("["):
+                actor = candidate
+
+        move_index = self._find_public_move_event(actor)
+        if move_index is None:
+            return False
+        move_event = self._public_events_current[move_index]
+
+        if event_type == "-notarget":
+            self._public_events_current[move_index] = replace(
+                move_event, failed=True, no_target=True, action_failed=True
+            )
+            return True
+
+        if len(event) < 3:
+            return False
+        if event_type == "-miss":
+            target = str(event[3]) if len(event) > 3 else ""
+            self._replace_public_move_target(move_index, target, missed=True)
+            amended = self._public_events_current[move_index]
+            self._public_events_current[move_index] = replace(amended, missed=True)
+            return True
+
+        target = str(event[2])
+        if event_type == "-immune":
+            self._replace_public_move_target(move_index, target, immune=True)
+        elif event_type == "-block":
+            blocked_by = str(event[3]) if len(event) > 3 else ""
+            self._replace_public_move_target(
+                move_index, target, blocked_by=blocked_by or None
+            )
