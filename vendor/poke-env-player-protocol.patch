+class _CapacityTestShard:
+    def __init__(self, index: int, *, capacity: int = 1, load_delay: float = 0.0):
+        self.index = index
+        self.capacity = capacity
+        self.loop = POKE_LOOP
+        self._load = 0
+        self._load_lock = Lock()
+        self._load_delay = load_delay
+
+    @property
+    def load(self) -> int:
+        if self._load_delay:
+            sleep(self._load_delay)
+        with self._load_lock:
+            return self._load
+
+    def _reserve(self) -> None:
+        with self._load_lock:
+            self._load += 1
+
+    def _release_reservation(self) -> None:
+        with self._load_lock:
+            self._load -= 1
+
+
+def _capacity_test_pool(
+    *shards: _CapacityTestShard,
+) -> _ShardedLocalBattleStreamWorkerPool:
+    pool = object.__new__(_ShardedLocalBattleStreamWorkerPool)
+    pool._shards = list(shards)
+    pool._start_lock = Lock()
+    pool._start_future = None
+    pool._started = True
+    pool._next_shard_index = 0
+    pool._allocation_lock = Lock()
+    pool._capacity_waiters = set()
+    return pool
+
+
+def test_sharded_pool_reserves_capacity_atomically_across_threads():
+    shards = (
+        _CapacityTestShard(0, load_delay=0.01),
+        _CapacityTestShard(1, load_delay=0.01),
+    )
+    pool = _capacity_test_pool(*shards)
+    start = Event()
+
+    def reserve_shard() -> _CapacityTestShard:
+        start.wait()
+        return asyncio.run(pool._reserve_available_shard())
+
+    with ThreadPoolExecutor(max_workers=2) as executor:
+        reservations = [executor.submit(reserve_shard) for _ in range(2)]
+        start.set()
+        selected = [reservation.result(timeout=1.0) for reservation in reservations]
+
+    assert sorted(shard.index for shard in selected) == [0, 1]
+    assert [shard.load for shard in shards] == [1, 1]
+
+
+@pytest.mark.asyncio
+async def test_sharded_pool_capacity_waiter_reselects_released_shard():
+    shards = (_CapacityTestShard(0), _CapacityTestShard(1))
+    pool = _capacity_test_pool(*shards)
+    first = await pool._reserve_available_shard()
+    second = await pool._reserve_available_shard()
+
+    waiting = asyncio.create_task(pool._reserve_available_shard())
+    await asyncio.sleep(0)
+
+    assert not waiting.done()
+    assert len(pool._capacity_waiters) == 1
+    assert "shard_loads=[0:1/1, 1:1/1]" in await pool.describe()
+    assert "capacity_waiters=1" in await pool.describe()
+
+    pool._release_shard_reservation(second)
+    selected = await asyncio.wait_for(waiting, timeout=1.0)
+
+    assert selected is second
+    assert [shard.load for shard in shards] == [1, 1]
+    pool._release_shard_reservation(first)
+    pool._release_shard_reservation(selected)
+
+
+@pytest.mark.asyncio
+async def test_sharded_pool_cancelled_capacity_wait_does_not_change_load():
+    shards = (_CapacityTestShard(0), _CapacityTestShard(1))
+    pool = _capacity_test_pool(*shards)
+    reservations = [await pool._reserve_available_shard() for _ in shards]
+
+    waiting = asyncio.create_task(pool._reserve_available_shard())
+    await asyncio.sleep(0)
+    assert len(pool._capacity_waiters) == 1
+
+    waiting.cancel()
+    with pytest.raises(asyncio.CancelledError):
+        await waiting
+
+    assert len(pool._capacity_waiters) == 0
+    assert [shard.load for shard in shards] == [1, 1]
+    for shard in reservations:
+        pool._release_shard_reservation(shard)
+
+
+@pytest.mark.asyncio
+async def test_sharded_pool_cancelled_acquire_releases_reserved_capacity():
+    acquire_started = asyncio.Event()
+    wait_forever = asyncio.Event()
+
+    class BlockingShard(_CapacityTestShard):
+        async def acquire_reserved(self):
+            acquire_started.set()
+            await wait_forever.wait()
+
+    shard = BlockingShard(0)
+    pool = _capacity_test_pool(shard)
+
+    acquire_task = asyncio.create_task(pool.acquire())
+    await asyncio.wait_for(acquire_started.wait(), timeout=1.0)
+    assert shard.load == 1
+
+    acquire_task.cancel()
+    with pytest.raises(asyncio.CancelledError):
+        await acquire_task
+
+    assert shard.load == 0
+    assert len(pool._capacity_waiters) == 0
+
+
