+    def _track_public_battle_event(self, event: List[str]) -> None:
+        """Track only bounded, high-level events from this player's public stream."""
+        if len(event) < 2:
+            return
+        event_type = event[1]
+        if event_type == "turn":
+            turn = int(event[2])
+            if turn <= 1:
+                # Initial lead switches precede |turn|1 but are team setup, not
+                # history available to the first policy decision.
+                self._public_events_previous = ()
+                self._public_events_previous_overflow = 0
+                self._public_events_previous_turn = 0
+            else:
+                self._public_events_previous = tuple(self._public_events_current)
+                self._public_events_previous_overflow = (
+                    self._public_events_current_overflow
+                )
+                self._public_events_previous_turn = turn - 1
+            self._public_events_current = []
+            self._public_events_current_overflow = 0
+            self._public_active_move_event_index = None
+            return
+
+        if self._amend_public_move_event(event):
+            return
+
+        # A minor move-result line is only associated with the active major
+        # move.  Explicit protocol boundaries prevent a later switch-in item,
+        # ability, weather, or upkeep message from mutating an older move.
+        if event_type in {
+            "",
+            "request",
+            "start",
+            "switch",
+            "drag",
+            "cant",
+            "faint",
+            "-terastallize",
+            "upkeep",
+            "win",
+            "tie",
+        }:
+            self._public_active_move_event_index = None
+
+        public_event = self._coerce_public_battle_event(event)
+        if public_event is None:
+            return
+        if len(self._public_events_current) < self.MAX_PUBLIC_BATTLE_EVENTS:
+            self._public_events_current.append(public_event)
+            self._public_active_move_event_index = (
+                len(self._public_events_current) - 1
+                if public_event.kind is PublicBattleEventKind.MOVE
+                else None
+            )
+        else:
+            self._public_events_current_overflow += 1
+            self._public_active_move_event_index = None
+
+    @staticmethod
+    def _coerce_public_battle_event(event: List[str]) -> PublicBattleEvent | None:
+        kind = _PUBLIC_EVENT_KINDS.get(event[1])
+        if kind is None or len(event) < 3:
+            return None
+
+        actor = str(event[2])
+        if kind is PublicBattleEventKind.MOVE:
+            move = str(event[3]) if len(event) > 3 else None
+            tokens = tuple(str(token) for token in event[4:])
+            target = None
+            if len(event) > 4:
+                candidate = str(event[4])
+                if candidate and not candidate.startswith("["):
+                    target = candidate
+            spread_targets: tuple[str, ...] = ()
+            for token in tokens:
+                if token.startswith("[spread]"):
+                    spread_targets = tuple(
+                        value.strip()
+                        for value in token[len("[spread]") :].split(",")
+                        if value.strip()
+                    )
+                    break
+            targets = spread_targets or ((target,) if target else ())
+            missed = "[miss]" in tokens
+            no_target = "[notarget]" in tokens
+            source_effect = next(
+                (
+                    token[len("[from]") :].strip()
+                    for token in tokens
+                    if token.startswith("[from]")
+                ),
+                None,
+            )
+            return PublicBattleEvent(
+                kind=kind,
+                actor=actor,
+                target=target,
+                move=move,
+                # ``[still]`` suppresses animation; it is not a failure.  The
+                # later ``-fail``/``-block`` messages carry that public fact.
+                failed=missed or no_target,
+                missed=missed,
+                spread=bool(spread_targets),
+                no_target=no_target,
+                action_failed=no_target,
+                source_effect=source_effect,
+                target_outcomes=tuple(
+                    PublicMoveTargetOutcome(
+                        target=value, declared_on_move_line=True, missed=missed
+                    )
+                    for value in targets
+                ),
+            )
+        if kind in {PublicBattleEventKind.SWITCH, PublicBattleEventKind.DRAG}:
+            return PublicBattleEvent(
+                kind=kind,
+                actor=actor,
+                details=str(event[3]) if len(event) > 3 else None,
+            )
+        if kind is PublicBattleEventKind.CANT:
+            return PublicBattleEvent(
+                kind=kind,
+                actor=actor,
+                move=str(event[4]) if len(event) > 4 else None,
+                details=str(event[3]) if len(event) > 3 else None,
+            )
+        if kind is PublicBattleEventKind.TERA:
+            return PublicBattleEvent(
+                kind=kind,
+                actor=actor,
+                details=str(event[3]) if len(event) > 3 else None,
+            )
+        return PublicBattleEvent(kind=kind, actor=actor)
